# Dependencies
node_modules/

# Build output
dist/
target/
# the desktop window's splash page (desktop/src-tauri/tauri.conf.json frontendDist) is source, not build output
!desktop/dist/

# Chorus local state (threads, artifacts, run captures)
.chorus/

# OS files
.DS_Store
Thumbs.db

# Installer downloads (scripts/release-downloads.mjs), published with the site
site/dl/
.firebase/

# written by Chorus whenever an agy chat starts in this folder (local paths, a chat id): never commit it
.agents/mcp_config.json
