{
  "name": "@chauvoluuhuong/chorus",
  "version": "1.0.5",
  "private": true,
  "description": "Work across AI coding CLIs: handoff, threads, skills",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chauvoluuhuong/chorus.git"
  },
  "homepage": "https://chorus-cli.web.app",
  "bugs": {
    "url": "https://github.com/chauvoluuhuong/chorus/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "chorus": "src/cli/index.ts",
    "chorus-cli": "src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:l1": "node --test --test-reporter=spec \"test/contract/*.test.ts\"",
    "smoke": "node test/smoke/run.ts",
    "postinstall": "node scripts/fix-pty.mjs",
    "risk": "node tools/risk/run.ts",
    "smoke:app": "node test/smoke/app.ts",
    "proof": "node test/smoke/proof.ts --open",
    "proof:agy": "node test/smoke/proof-agy.ts --open",
    "install:global": "node scripts/install.mjs",
    "start": "node src/cli/index.ts",
    "smoke:artifacts": "node test/smoke/artifacts.ts",
    "proof:desktop": "node test/smoke/proof-desktop.ts --open",
    "serve": "node src/cli/index.ts serve --open",
    "smoke:ask": "node test/smoke/ask.ts",
    "release:downloads": "node scripts/release-downloads.mjs",
    "deploy:site": "node scripts/build-site.mjs && firebase deploy --only hosting:chorus-cli --project lh-landing-page"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@chauvoluuhuong/chorus-core": "file:../chorus-core",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
